RewriteEngine On

# Blokir akses publik ke file sensitif (.env, .git, .sql, dll)
<FilesMatch "^(\.env|\.env\..*|\.git.*|.*\.sql|composer\.(json|lock))$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Redirect directly if user manually types .php (Optional, for strictly clean URLs)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Silently map clean URL to .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]
